APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=SET_IN_SECRET_MANAGER
BOOTSTRAP_TOKEN=SET_IN_SECRET_MANAGER
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@DB_HOST:5432/udx_payments
REDIS_URL=redis://REDIS_HOST:6379/0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=https://payments.example.com
SECRET_PROVIDER=aws
AWS_SECRET_NAME=udx/payments/production
AWS_REGION=sa-east-1
DATA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=udx-payments
JWT_AUDIENCE=udx-payments-api
JWT_ACTIVE_KID=v1
JWT_KEYS_JSON={}
ALLOW_MANUAL_SETTLEMENT=false
PAYMENT_PROVIDER=disabled
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_TIMEOUT_SECONDS=10
WEBHOOK_REPLAY_WINDOW_SECONDS=300
