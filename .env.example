APP_NAME=UDX Solucoes de Pagamentos
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
DATABASE_URL=postgresql+psycopg://udx:udx@postgres:5432/udx_payments
REDIS_URL=redis://redis:6379/0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
JWT_ALGORITHM=HS256
JWT_ISSUER=udx-payments
JWT_AUDIENCE=udx-payments-api
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_MFA_CHALLENGE_MINUTES=5
