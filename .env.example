APP_NAME=UDX Solucoes de Pagamentos
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_TOKEN=replace-with-a-random-bootstrap-token
DATABASE_URL=postgresql+psycopg://udx:udx@postgres:5432/udx_payments
REDIS_URL=redis://redis:6379/0
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
SECRET_PROVIDER=env
AWS_SECRET_NAME=
AWS_REGION=us-east-1
DATA_ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
JWT_ALGORITHM=HS256
JWT_ISSUER=udx-payments
JWT_AUDIENCE=udx-payments-api
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
JWT_MFA_CHALLENGE_MINUTES=5
JWT_ACTIVE_KID=v1
JWT_KEYS_JSON={"v1":"replace-with-a-random-jwt-signing-key"}
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_MFA_RATE_LIMIT=8
AUTH_MFA_RATE_WINDOW_SECONDS=300
AUTH_LOCK_THRESHOLD=5
AUTH_LOCK_MAX_MINUTES=60
MFA_RECOVERY_CODE_COUNT=10
# Development/testing only. Must be false in production.
ALLOW_MANUAL_SETTLEMENT=true
